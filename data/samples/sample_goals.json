# Sample Goals
#
# Purpose: Example goal records for testing and seeding
#
# Schema:
#   {
#     "id": "uuid",
#     "user_id": "uuid",
#     "title": "Run a marathon",
#     "description": "Complete a full marathon in under 4 hours",
#     "state": "active",
#     "abstraction_level": "medium_term",
#     "created_at": "ISO 8601",
#     "target_date": "ISO 8601",
#     "priority": 0.8,
#     "related_goals": ["uuid", "uuid"],
#     "tasks": [
#       { "title": "Build endurance", "status": "in_progress" },
#       { "title": "Train twice weekly", "status": "active" }
#     ],
#     "progress": 0.35,
#     "notes": "Starting training next month"
#   }
#
# Examples:
#   - Active goals (current focus)
#   - Completed goals (archived)
#   - Paused goals (temporary)
#   - Abandoned goals (given up)
#   - Someday goals (aspirational)
#
# Test coverage:
#   - All goal states
#   - Various abstraction levels
#   - Goals with conflicts
#   - Goals with task breakdown
#   - Varied priority and progress
