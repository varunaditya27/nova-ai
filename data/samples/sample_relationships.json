# Sample Relationships
#
# Purpose: Example relationship records for testing and seeding
#
# Schema:
#   {
#     "id": "uuid",
#     "user_id": "uuid",
#     "person_name": "Alice",
#     "stage": "close",
#     "tie_strength": 0.65,
#     "interaction_frequency": 15,  # contacts in last 30 days
#     "last_interaction": "ISO 8601",
#     "vulnerability_shared": 0.7,
#     "reciprocity_score": 0.8,
#     "milestones": ["met in college", "moved to same city"],
#     "created_at": "ISO 8601"
#   }
#
# Examples:
#   - Close friend (high tie strength)
#   - Family member (varied stages)
#   - Colleague (casual)
#   - Partner (intimate)
#   - Acquaintance from hobby
#   - Estranged family member
#
# Test coverage:
#   - All relationship stages (acquaintance, casual, close, intimate, estranged)
#   - Varied tie strength scores (0.0-1.0)
#   - Different interaction frequencies
#   - Recent and old relationships
