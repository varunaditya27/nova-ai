# Copy to docker/.env and fill in. Never commit .env.
# For production, replace the dev credentials below with strong secrets from a secret manager.

# Model tiers (fully offline, all Ollama) — override to point at a different local model
# NOVA_MAIN_MODEL=qwen2.5:7b
# NOVA_MINI_MODEL=gemma2:2b

# Postgres (relational store) — change these for anything beyond local dev
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova
POSTGRES_DB=nova
DATABASE_URL=postgresql+psycopg://nova:nova@postgres:5432/nova

# ChromaDB (vector store)
CHROMA_HOST=chroma
CHROMA_PORT=8000

# Ollama (local inference)
OLLAMA_BASE_URL=http://ollama:11434

# Kokoro (TTS)
KOKORO_BASE_URL=http://kokoro:8880

# faster-whisper (STT)
STT_URL=http://stt:8000
